{
  "name": "pi-pod",
  "version": "0.2.0",
  "description": "Run Pi and OpenCode in a hardened rootless Podman workspace",
  "module": "index.ts",
  "types": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "README.md",
    "docs/**/*.md",
    "config/agents/*.json",
    "scripts/dev-launcher",
    "container/Containerfile",
    "container/package.json",
    "container/bun.lock",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliusrajala/pi-pod.git"
  },
  "homepage": "https://github.com/juliusrajala/pi-pod#readme",
  "bugs": {
    "url": "https://github.com/juliusrajala/pi-pod/issues"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "pi-pod": "./scripts/dev-launcher",
    "pi-pod-dev": "./scripts/dev-launcher"
  },
  "scripts": {
    "cli:dev": "./scripts/dev-launcher",
    "build:image:dev": "./scripts/dev-launcher build",
    "build:release": "bun run scripts/build-release.ts",
    "verify:release": "bun run scripts/verify-release.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run format:check && bun test && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.5.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@crustjs/core": "0.0.19"
  }
}
