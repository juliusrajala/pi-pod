{
  "name": "pi-pod",
  "version": "0.1.0",
  "description": "Run Pi and OpenCode in a hardened rootless Podman workspace",
  "module": "index.ts",
  "types": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    }
  },
  "files": [
    "index.ts",
    "README.md",
    "bin/pi-pod",
    "container/Containerfile",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "pi-pod": "./bin/pi-pod"
  },
  "scripts": {
    "cli": "./bin/pi-pod",
    "build:image": "./bin/pi-pod build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@crustjs/core": "0.0.19"
  }
}
