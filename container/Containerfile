FROM docker.io/library/node@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96

ARG BUN_VERSION=1.3.14
ARG BUN_SHA256=951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f
ARG PI_VERSION=0.85.1
ARG OPENCODE_VERSION=1.18.27

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl fd-find git ripgrep unzip \
  && test "$(dpkg --print-architecture)" = "amd64" \
  && curl --fail --location --silent --show-error \
    "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-linux-x64.zip" \
    --output /tmp/bun.zip \
  && echo "${BUN_SHA256}  /tmp/bun.zip" | sha256sum --check --status \
  && unzip -q /tmp/bun.zip -d /tmp \
  && install -m 755 /tmp/bun-linux-x64/bun /usr/local/bin/bun \
  && ln -s /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/* /tmp/bun.zip /tmp/bun-linux-x64

# The lockfile contains integrity records for the complete native agent trees.
# Install scripts stay disabled so registry packages cannot execute build-time
# code as root; the image only exposes the reviewed package bins.
COPY package.json bun.lock /tmp/pi-pod-agent/
RUN cd /tmp/pi-pod-agent \
  && test "$(bun --version)" = "${BUN_VERSION}" \
  && grep -F "\"@earendil-works/pi-coding-agent@${PI_VERSION}\"" bun.lock \
  && grep -F "\"opencode-ai@${OPENCODE_VERSION}\"" bun.lock \
  && bun install --frozen-lockfile --ignore-scripts --production \
  && mkdir -p /opt/pi-pod-agent \
  && mv node_modules /opt/pi-pod-agent/node_modules \
  && ln -s /opt/pi-pod-agent/node_modules/.bin/pi /usr/local/bin/pi \
  && ln -s /opt/pi-pod-agent/node_modules/.bin/opencode /usr/local/bin/opencode \
  && rm -rf /tmp/pi-pod-agent

ENV HOME=/home/agent
WORKDIR /workspace
RUN mkdir -p /workspace /home/agent/.pi/agent /home/agent/.local/share/opencode \
  && chown -R node:node /workspace /home/agent /opt/pi-pod-agent
USER node

CMD ["bash"]
