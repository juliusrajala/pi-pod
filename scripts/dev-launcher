#!/bin/sh
# Source-only entrypoint. Prefer `bun run dev` from the trusted checkout.
set -eu

script_path=$(/usr/bin/readlink -f -- "$0")
package_root=${script_path%/scripts/*}
caller_cwd=$(/bin/pwd -P)
host_home=${HOME-}

# Resolve the normally installed Bun from the trusted checkout. Never probe a
# workspace executable or let workspace/global bunfig files preload the CLI.
CDPATH='' cd -- "$package_root"
bun_path=${PI_POD_BUN_PATH:-$(command -v bun || true)}
case "$bun_path" in
  /*) ;;
  *) printf '%s\n' 'Install Bun 1.3.14 or later and put it on PATH.' >&2; exit 1 ;;
esac
bun_path=$(/usr/bin/readlink -f -- "$bun_path")
case "$bun_path" in
  "$package_root"/*) ;;
  "$caller_cwd"|"$caller_cwd"/*)
    printf '%s\n' 'Refusing to execute Bun from the target workspace.' >&2; exit 1 ;;
esac
export HOME=/dev/null
actual=$("$bun_path" --version)
if ! printf '%s\n' 1.3.14 "$actual" | /usr/bin/sort -VC; then
  printf '%s\n' "pi-pod requires Bun 1.3.14 or later; found $actual." >&2
  exit 1
fi

trusted_tool_path=${PI_POD_TRUSTED_PATH-}
case "$trusted_tool_path" in
  ''|/*) ;;
  *) printf '%s\n' 'PI_POD_TRUSTED_PATH must be an absolute path.' >&2; exit 1 ;;
esac
export PATH="${bun_path%/*}${trusted_tool_path:+:$trusted_tool_path}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PI_POD_CALLER_CWD="$caller_cwd"
export PI_POD_HOST_HOME="$host_home"
export PI_POD_LAUNCHER="$script_path"
exec "$bun_path" --cwd "$package_root" --no-env-file "$package_root/src/cli.ts" "$@"
